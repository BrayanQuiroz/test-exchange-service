  "item": [
    {
      "name": "1. Convertir Moneda - Exitoso (USD a PEN)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"monto\": 100,\n  \"monedaOrigen\": \"USD\",\n  \"monedaDestino\": \"PEN\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/exchange/convert",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "exchange",
            "convert"
          ]
        }
      },
      "response": []
    },
    {
